import urllib.parse
import urllib.request


BASE_URL = "https://services.leadconnectorhq.com"
VERSION = "2021-07-28"
TASKS_VERSION = "v3"
TASK_SEARCH_PAGE_SIZE = 20
OPPORTUNITY_SEARCH_PAGE_SIZE = 100
CONVERSATIONS_VERSION = "2021-04-15"
CONVERSATION_MESSAGES_VERSION = "v3"
CLI_VERSION = "0.3.0"
WRITE_METHODS = {"POST", "PUT", "PATCH", "DELETE"}
GENERIC_DEFAULT_PIPELINE = "Sales Pipeline"
GENERIC_CANONICAL_STAGES = [
    "New Lead",
    "Engaged",
    "Qualified",
    "Meeting Booked",
    "Discovery Complete",
    "Proposal Sent",
    "Nurture",
]
GENERIC_CANONICAL_TAGS = ["client", "prospect", "partner", "do-not-contact", "needs-cleanup"]
CONFIG_FILENAMES = (".ghl-cli.json", "ghl-cli.json")
_CONFIG = None
_DOTENV = None
PRIVATE_INPUT_MAX_BYTES = 1024 * 1024
CAPTURE_PRIVATE_INPUT_MAX_BYTES = 32 * 1024 * 1024
CAPTURE_COMMENT_MAX_BYTES = 8 * 1024 * 1024
INTERNAL_COMMENT_PAGE_SIZE = 100
INTERNAL_COMMENT_MAX_PAGES = 1000
