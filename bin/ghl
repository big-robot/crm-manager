    print_json(data)


def require_delete_confirmation(args):
    if not args.yes:
        return
    if args.confirm_delete != args.id:
        fail(f"refusing delete; rerun with --confirm-delete {args.id}")


def prompt_value(label, default):
    if not sys.stdin.isatty():
        return default
    suffix = f" [{default}]" if default else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or default


def split_csv(value):
    return [part.strip() for part in value.split(",") if part.strip()]


def init_cli(args):
    target = Path(args.config).expanduser()

    pipeline = args.default_pipeline or prompt_value("Default pipeline name", GENERIC_DEFAULT_PIPELINE)
    stages = split_csv(args.stages or prompt_value("Pipeline stages", ", ".join(GENERIC_CANONICAL_STAGES)))
    tags = split_csv(args.tags or prompt_value("Canonical tags", ", ".join(GENERIC_CANONICAL_TAGS)))
    company_name = args.example_company or prompt_value("Example company name", "Example Co")
    contact_name = args.example_contact or prompt_value("Example contact name", "Jane Doe")
    contact_email = args.example_email or prompt_value("Example contact email", "jane@example.com")
    opportunity_name = args.example_opportunity or prompt_value(
        "Example opportunity name",
        f"{company_name} - Managed Service",
    )

    if target.exists() and not args.force:
        fail(f"{target} already exists; use --force to overwrite")

    config = {
        "defaultPipeline": pipeline,
        "canonicalStages": stages,
        "canonicalTags": tags,
        "examples": {
            "companyName": company_name,
            "contactName": contact_name,
            "contactEmail": contact_email,
            "contactSearch": company_name,
            "opportunityName": opportunity_name,
            "monthlyAmount": 1500,
            "annualValue": 18000,
        },
    }

    target.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    next_steps = [
        "Create a GHL private integration token with the README permissions.",
    ]
    if not find_dotenv_path():
        next_steps.append("Copy .env.example to .env and set GHL_LOCATION_ID and GHL_PRIVATE_INTEGRATION_TOKEN securely.")
    else:
        next_steps.append("Run ghl doctor to verify the repo-root .env and API permissions.")
    next_steps.append("Run ghl help agent.")

    print_json({
        "created": [str(target)],
        "envFile": str(find_dotenv_path()) if find_dotenv_path() else None,
        "next": next_steps,
    })


def help_agent(args):
    pipeline = default_pipeline_name()
    examples = example_config()
    contact_name = examples.get("contactName", "Jane Doe")
    contact_email = examples.get("contactEmail", "jane@example.com")
    company_name = examples.get("companyName", "Example Co")
    contact_query = examples.get("contactSearch", company_name)
    opportunity_name = examples.get("opportunityName", f"{company_name} - Managed Service")
    monthly_amount = examples.get("monthlyAmount", 1500)
    annual_value = examples.get("annualValue", int(monthly_amount) * 12 if isinstance(monthly_amount, int) else 18000)
    print(f"""GHL CLI agent cheat sheet

Security:
- Never print GHL_PRIVATE_INTEGRATION_TOKEN or full env.
- Use reads first. Writes require global --yes before the command.
- Deletes require global --yes and --confirm-delete ID.
- Do not send outbound messages, payments, social posts, or GHL automations.
- Prefer user-specific examples from .ghl-cli.json when present.

First commands:
- ghl doctor
- ghl pipelines
- ghl fields --model opportunity
- ghl contacts search --query "Company or person"
- ghl tasks search --limit 100
- ghl users list
- ghl opportunities search --pipeline "{pipeline}" --status all --limit 100

Write flag:
- Dry run: ghl contacts upsert --name "{contact_name}" --email "{contact_email}"
- Execute: ghl --yes contacts upsert --name "{contact_name}" --email "{contact_email}"
- --yes is global and must appear before contacts/opportunities/tags.

Contacts:
- Search: ghl contacts search --query "{contact_query}" --limit 20
- Exact read: ghl contacts get CONTACT_ID
- Create (may trigger configured location automations): ghl --yes contacts create --name "{contact_name}" --email "{contact_email}" --company "{company_name}"
- Upsert: ghl --yes contacts upsert --name "{contact_name}" --email "{contact_email}" --company "{company_name}" --tag prospect --field "Account Status=Prospect" --field "Primary Relationship=Decision Maker"
- Update: ghl --yes contacts update CONTACT_ID --phone-entry "Mobile=+15550101001" --phone-entry "Work=+15550101002" --additional-email "alternate@example.invalid" --field "Account Notes=..."
- DND: ghl --yes contacts dnd CONTACT_ID --channel Email --status active
- Delete: ghl --yes contacts delete CONTACT_ID --confirm-delete CONTACT_ID

Opportunities:
- Search: ghl opportunities search --pipeline "{pipeline}" --status all --limit 100
- Create: ghl --yes opportunities create --contact-id CONTACT_ID --name "{opportunity_name}" --pipeline "{pipeline}" --stage "Proposal Sent" --status open --value {annual_value} --field "Revenue Model=Monthly Recurring" --field "Monthly Amount={monthly_amount}" --field "Forecast Term Months=12" --field "Forecast Value Basis=First-year recurring value"
- Update: ghl --yes opportunities update OPPORTUNITY_ID --pipeline "{pipeline}" --stage "Qualified" --value 0 --field "Next Step=Book discovery."
- Next-step hygiene (only fields it can touch): ghl --yes opportunities next-step OPPORTUNITY_ID --step "Follow up after install." --date 2026-07-10
- Delete: ghl --yes opportunities delete OPPORTUNITY_ID --confirm-delete OPPORTUNITY_ID

Tasks:
- Search: ghl tasks search --limit 100
- Exclude unlinked search records: ghl tasks search --limit 100 --exclude-unlinked
- Dry run: ghl tasks create --contact-id CONTACT_ID --title "Follow up" --body "Context" --due 2026-07-14T09:00:00-04:00 --assigned-to USER_ID
- Execute: ghl --yes tasks create --contact-id CONTACT_ID --title "Follow up" --body "Context" --due 2026-07-14T09:00:00-04:00 --assigned-to USER_ID
- Update due date: ghl --yes tasks update TASK_ID --contact-id CONTACT_ID --due 2026-07-20T09:00:00-04:00
- Complete: ghl --yes tasks complete TASK_ID --contact-id CONTACT_ID
- Delete: ghl --yes tasks delete TASK_ID --contact-id CONTACT_ID --confirm-delete TASK_ID

Users (read-only):
- List: ghl users list

Conversations (read-only):
- Search by contact: ghl conversations search --contact-id CONTACT_ID
- Search by text: ghl conversations search --query "{contact_query}" --limit 20
- Thread messages: ghl conversations messages CONVERSATION_ID --limit 50
- Full email body: ghl conversations email EMAIL_MESSAGE_ID
- Conversations are read-only in this CLI: no send, reply, update, or delete exists, by policy.

Recurring value rule:
- Monthly recurring opportunity value = expected first-year revenue.
- Store monthly price in Monthly Amount.
- Set Forecast Term Months=12 and Forecast Value Basis=First-year recurring value.
- One-time proposals use exact proposal total.
- Unpriced discovery items stay value 0 with Revenue Model=TBD.

Configured pipeline:
- {pipeline}: {", ".join(canonical_stages())}
""")


def doctor(args):
    default_pipeline = default_pipeline_name()
    config_path = find_config_path()
    result = {
        "env": {
            "GHL_LOCATION_ID": "present" if env_present("GHL_LOCATION_ID") else "missing",
            "GHL_PRIVATE_INTEGRATION_TOKEN": "present" if env_present("GHL_PRIVATE_INTEGRATION_TOKEN") else "missing",
        },
        "api": {
            "reachable": False,
            "error": None,
        },
        "crm": {
            "configPath": str(config_path) if config_path else None,
            "defaultPipeline": default_pipeline,
        },
        "next": None,
    }

    if not env_present("GHL_LOCATION_ID") or not env_present("GHL_PRIVATE_INTEGRATION_TOKEN"):
        result["next"] = "Set missing env vars. Do not print token values."
        print_json(result)
        return

    try:
        pipe_rows = pipelines()
        tags = request("GET", f"/locations/{location_id()}/tags").get("tags", [])
        contact_fields = custom_fields("contact")
        opportunity_fields = custom_fields("opportunity")
    except SystemExit as exc:
        result["api"]["error"] = f"GHL request failed with exit code {exc.code}"
        result["next"] = "Check token scopes, token freshness, and location id."
        print_json(result)
        return

    default_pipeline_record = next((pipe for pipe in pipe_rows if pipe.get("name") == default_pipeline), None)
    tag_names = {tag.get("name") for tag in tags if isinstance(tag, dict)}
    result["api"]["reachable"] = True
    result["crm"] = {
        "configPath": str(config_path) if config_path else None,
        "defaultPipelinePresent": bool(default_pipeline_record),
        "defaultPipeline": default_pipeline,
        "stages": [stage.get("name") for stage in (default_pipeline_record or {}).get("stages", [])],
        "tagCount": len(tags),
        "canonicalTagsPresent": sorted(
            set(canonical_tags()) & tag_names
        ),
        "contactFieldNames": sorted(field.get("name") for field in contact_fields if field.get("name")),
        "opportunityFieldNames": sorted(field.get("name") for field in opportunity_fields if field.get("name")),
    }
    result["next"] = "Use bin/ghl help agent for command recipes."
    print_json(result)


def cleanup_audit(args):
    default_pipeline = default_pipeline_name()
    expected_stages = canonical_stages()
    expected_tags = set(canonical_tags())
    pipe_rows = pipelines()
    tags = request("GET", f"/locations/{location_id()}/tags").get("tags", [])
    tag_names = {tag.get("name") for tag in tags if isinstance(tag, dict)}
    default_pipeline_record = next((pipe for pipe in pipe_rows if pipe.get("name") == default_pipeline), None)
    legacy = [pipe.get("name") for pipe in pipe_rows if pipe.get("name") != default_pipeline]
    disposable_contacts = request("POST", "/contacts/search", body={
        "locationId": location_id(),
        "page": 1,
        "pageLimit": 20,
        "query": "Codex",
    }, mutates=False)
    disposable_opps = request("GET", "/opportunities/search", query={
        "location_id": location_id(),
        "limit": 20,
        "status": "all",
        "q": "Codex",
    })
    result = {
        "pipeline": {
            "defaultPipeline": default_pipeline,
            "defaultPipelinePresent": bool(default_pipeline_record),
            "defaultPipelineStages": [stage.get("name") for stage in (default_pipeline_record or {}).get("stages", [])],
            "stageMismatch": bool(default_pipeline_record) and [stage.get("name") for stage in default_pipeline_record.get("stages", [])] != expected_stages,
            "legacyPipelinesPresent": legacy,
        },
        "tags": {
            "canonicalMissing": sorted(expected_tags - tag_names),
            "nonCanonicalCount": len(tag_names - expected_tags),
            "nonCanonicalSample": sorted(tag_names - expected_tags)[:50],
        },
        "disposableTestRecords": {
            "contacts": [
                {"id": c.get("id"), "name": c.get("contactName") or c.get("name"), "email": c.get("email")}
                for c in disposable_contacts.get("contacts", [])
            ],
            "opportunities": [
                {"id": o.get("id"), "name": o.get("name"), "status": o.get("status")}
                for o in disposable_opps.get("opportunities", [])
            ],
        },
        "next": "Review only. This command does not delete or mutate cleanup targets.",
    }
    print_json(result)


def build_parser():
    parser = argparse.ArgumentParser(prog="ghl")
    parser.add_argument("--yes", action="store_true", help="execute writes; otherwise writes are dry-run")
    parser.add_argument("--version", action="version", version=f"%(prog)s {CLI_VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    help_cmd = sub.add_parser("help")
    help_sub = help_cmd.add_subparsers(dest="help_command", required=True)
    help_sub.add_parser("agent").set_defaults(func=help_agent)

    init = sub.add_parser("init")
    init.add_argument("--config", default=".ghl-cli.json")
    init.add_argument("--default-pipeline")
    init.add_argument("--stages", help="comma-separated stage names")
    init.add_argument("--tags", help="comma-separated tag names")
    init.add_argument("--example-company")
    init.add_argument("--example-contact")
    init.add_argument("--example-email")
    init.add_argument("--example-opportunity")
    init.add_argument("--force", action="store_true")
    init.set_defaults(func=init_cli)

    sub.add_parser("doctor").set_defaults(func=doctor)

    sub.add_parser("pipelines").set_defaults(func=summarize_pipelines)

    fields = sub.add_parser("fields")
    fields.add_argument("--model", choices=["all", "contact", "opportunity"], default="all")
    fields.set_defaults(func=summarize_fields)

    tags = sub.add_parser("tags")
    tags_sub = tags.add_subparsers(dest="tags_command", required=True)
    tags_sub.add_parser("list").set_defaults(func=list_tags)
    tag_create = tags_sub.add_parser("create")
    tag_create.add_argument("name")
    tag_create.set_defaults(func=create_tag)
    tag_delete = tags_sub.add_parser("delete")
    tag_delete.add_argument("id")
    tag_delete.add_argument("--confirm-delete", help="required with --yes; must equal id")
    tag_delete.set_defaults(func=delete_tag)

    contacts = sub.add_parser("contacts")
    contacts_sub = contacts.add_subparsers(dest="contacts_command", required=True)
    contact_search = contacts_sub.add_parser("search")
    contact_search.add_argument("--query")
    contact_search.add_argument("--limit", type=int, default=20)
    contact_search.add_argument("--page", type=int, default=1)
    contact_search.set_defaults(func=search_contacts)
    contact_get = contacts_sub.add_parser("get")
    contact_get.add_argument("id")
    contact_get.set_defaults(func=get_contact)
    contact_create = contacts_sub.add_parser("create")
    add_contact_write_arguments(contact_create, require_name=True)
    contact_create.set_defaults(func=create_contact)
    contact_upsert = contacts_sub.add_parser("upsert")
    contact_upsert.add_argument("--name")
    contact_upsert.add_argument("--email")
    contact_upsert.add_argument("--phone")
    contact_upsert.add_argument("--company")
    contact_upsert.add_argument("--tag", action="append")
    contact_upsert.add_argument("--field", action="append", help="custom field as NAME=VALUE")
    contact_upsert.set_defaults(func=upsert_contact)
    contact_update = contacts_sub.add_parser("update")
    contact_update.add_argument("id")
    add_contact_write_arguments(contact_update)
    contact_update.set_defaults(func=update_contact)
    contact_dnd = contacts_sub.add_parser("dnd")
    contact_dnd.add_argument("id")
    contact_dnd.add_argument("--channel", choices=DND_CHANNELS, required=True)
    contact_dnd.add_argument("--status", choices=DND_STATUSES, required=True)
    contact_dnd.set_defaults(func=update_contact_dnd)
    contact_delete = contacts_sub.add_parser("delete")
    contact_delete.add_argument("id")
    contact_delete.add_argument("--confirm-delete", help="required with --yes; must equal id")
    contact_delete.set_defaults(func=delete_contact)

    opps = sub.add_parser("opportunities")
    opps_sub = opps.add_subparsers(dest="opportunities_command", required=True)
    opp_search = opps_sub.add_parser("search")
    opp_search.add_argument("--query")
    opp_search.add_argument("--pipeline")
    opp_search.add_argument("--status", choices=["open", "won", "lost", "abandoned", "all"], default="all")
    opp_search.add_argument("--limit", type=int, default=20)
    opp_search.set_defaults(func=search_opportunities)
    opp_create = opps_sub.add_parser("create")
    opp_create.add_argument("--contact-id", required=True)
    opp_create.add_argument("--name", required=True)
    opp_create.add_argument("--pipeline", default=default_pipeline_name())
    opp_create.add_argument("--stage", required=True)
    opp_create.add_argument("--status", choices=["open", "won", "lost", "abandoned"], default="open")
    opp_create.add_argument("--value", type=float)
    opp_create.add_argument("--field", action="append", help="custom field as NAME=VALUE")
    opp_create.set_defaults(func=create_opportunity)
    opp_update = opps_sub.add_parser("update")
    opp_update.add_argument("id")
    opp_update.add_argument("--name")
    opp_update.add_argument("--pipeline")
    opp_update.add_argument("--stage")
    opp_update.add_argument("--status", choices=["open", "won", "lost", "abandoned"])
    opp_update.add_argument("--value", type=float)
    opp_update.add_argument("--field", action="append", help="custom field as NAME=VALUE")
    opp_update.set_defaults(func=update_opportunity)
    opp_next = opps_sub.add_parser(
        "next-step", help="hygiene-only update of Next Step / Next Step Date"
    )
    opp_next.add_argument("id")
    opp_next.add_argument("--step", help="Next Step text")
    opp_next.add_argument("--date", help="Next Step Date as YYYY-MM-DD")
    opp_next.set_defaults(func=next_step_opportunity)
    opp_delete = opps_sub.add_parser("delete")
    opp_delete.add_argument("id")
    opp_delete.add_argument("--confirm-delete", help="required with --yes; must equal id")
    opp_delete.set_defaults(func=delete_opportunity)

    tasks = sub.add_parser("tasks", help="access to GHL contact follow-up tasks")
    tasks_sub = tasks.add_subparsers(dest="tasks_command", required=True)
    task_search = tasks_sub.add_parser("search")
    task_search.add_argument("--limit", type=int, default=100)
    task_search.add_argument(
        "--exclude-unlinked",
        action="store_true",
        help="exclude records without a contactId",
    )
    task_search.set_defaults(func=search_tasks)
    task_create = tasks_sub.add_parser("create")
    task_create.add_argument("--contact-id", required=True)
    task_create.add_argument("--title", required=True)
    task_create.add_argument("--body")
    task_create.add_argument("--due", required=True, help="ISO 8601 datetime with timezone")
    task_create.add_argument("--assigned-to", required=True, help="GHL user id")
    task_create.set_defaults(func=create_task)
    task_update = tasks_sub.add_parser("update")
    task_update.add_argument("id")
    task_update.add_argument("--contact-id", required=True)
    task_update.add_argument("--title")
    task_update.add_argument("--body")
    task_update.add_argument("--due", help="ISO 8601 datetime with timezone")
    task_update.add_argument("--assigned-to", help="GHL user id")
    task_update.set_defaults(func=update_task)
    task_complete = tasks_sub.add_parser("complete")
    task_complete.add_argument("id")
    task_complete.add_argument("--contact-id", required=True)
    task_complete.set_defaults(func=complete_task)
    task_delete = tasks_sub.add_parser("delete")
    task_delete.add_argument("id")
    task_delete.add_argument("--contact-id", required=True)
    task_delete.add_argument("--confirm-delete", help="required with --yes; must equal id")
    task_delete.set_defaults(func=delete_task)

    users = sub.add_parser("users", help="read-only access to GHL users")
    users_sub = users.add_subparsers(dest="users_command", required=True)
    users_sub.add_parser("list").set_defaults(func=list_users)

    convos = sub.add_parser("conversations", help="read-only access to captured conversations")
    convos_sub = convos.add_subparsers(dest="conversations_command", required=True)
    convo_search = convos_sub.add_parser("search")
    convo_search.add_argument("--contact-id")
    convo_search.add_argument("--query")
    convo_search.add_argument("--limit", type=int, default=20)
    convo_search.set_defaults(func=search_conversations)
    convo_messages = convos_sub.add_parser("messages")
    convo_messages.add_argument("id")
    convo_messages.add_argument("--limit", type=int, default=20)
    convo_messages.set_defaults(func=conversation_messages)
    convo_email = convos_sub.add_parser("email")
    convo_email.add_argument("id")
    convo_email.set_defaults(func=conversation_email)

    cleanup = sub.add_parser("cleanup")
    cleanup_sub = cleanup.add_subparsers(dest="cleanup_command", required=True)
    cleanup_sub.add_parser("audit").set_defaults(func=cleanup_audit)
    return parser


def main():
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
