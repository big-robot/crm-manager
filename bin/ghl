CAPTURE_METADATA_END = "--- end-message-monitor ---"


class CaptureMetadataError(ValueError):
    pass


class UntrustedJsonError(ValueError):
    pass


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, _request, _file, _code, _message, _headers, _new_url):
        return None


HTTP_OPENER = urllib.request.build_opener(NoRedirectHandler)


def fail(message, code=1):
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_untrusted_json(raw):
    try:
        return json.loads(raw)
    except (ValueError, RecursionError) as exc:
        raise UntrustedJsonError from exc


def candidate_roots():
    roots = []
    for base in [Path.cwd(), Path(__file__).resolve().parent.parent]:
        for current in [base, *base.parents]:
            if current not in roots:
                roots.append(current)
    return roots


def find_dotenv_path():
    explicit = os.environ.get("GHL_ENV_FILE")
    if explicit:
        path = Path(explicit).expanduser()
        return path if path.exists() else None

    for root in candidate_roots():
        path = root / ".env"
        if path.exists():
            return path
    return None


def parse_dotenv_line(line):
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    if line.startswith("export "):
        line = line[len("export "):].strip()
    if "=" not in line:
        return None
    key, value = line.split("=", 1)
    key = key.strip()
    value = value.strip()
    if not key:
        return None
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        value = value[1:-1]
    return key, value


def dotenv_values():
    global _DOTENV
    if _DOTENV is not None:
        return _DOTENV

    path = find_dotenv_path()
    if not path:
        _DOTENV = {}
        return _DOTENV

    values = {}
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            parsed = parse_dotenv_line(line)
            if parsed:
                key, value = parsed
                values[key] = value
    except OSError as exc:
        fail(f"could not read env file {path}: {exc}")
    _DOTENV = values
    return _DOTENV


def env(name):
    value = os.environ.get(name) or dotenv_values().get(name)
    if not value:
        fail(f"missing {name}")
    return value


def location_id():
    return env("GHL_LOCATION_ID")


def token():
    return env("GHL_PRIVATE_INTEGRATION_TOKEN")


def print_json(value):
    print(json.dumps(value, indent=2, sort_keys=False))


def api_base_url():
    override = os.environ.get("GHL_TEST_BASE_URL")
    if not override:
        return BASE_URL
    try:
        parsed = urllib.parse.urlsplit(override)
        hostname = parsed.hostname
        parsed.port
    except ValueError:
        fail("invalid test API endpoint")
    if (
        parsed.scheme != "http"
        or hostname not in {"127.0.0.1", "localhost", "::1"}
        or parsed.username
        or parsed.password
        or parsed.path not in {"", "/"}
        or parsed.query
        or parsed.fragment
    ):
        fail("invalid test API endpoint")
    if not os.environ.get("GHL_LOCATION_ID") or not os.environ.get(
        "GHL_PRIVATE_INTEGRATION_TOKEN"
    ):
        fail("test API endpoint requires explicit credentials")
    return override.rstrip("/")


def find_config_path():
    explicit = os.environ.get("GHL_CLI_CONFIG")
    if explicit:
        path = Path(explicit).expanduser()
        return path if path.exists() else None

    for current in candidate_roots():
        for filename in CONFIG_FILENAMES:
            path = current / filename
            if path.exists():
                return path
    return None


def load_config():
    global _CONFIG
    if _CONFIG is not None:
        return _CONFIG

    path = find_config_path()
    if not path:
        _CONFIG = {}
        return _CONFIG

    try:
        with path.open("r", encoding="utf-8") as handle:
            _CONFIG = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"could not read config {path}: {exc}")
    return _CONFIG


def default_pipeline_name():
    return os.environ.get("GHL_DEFAULT_PIPELINE") or load_config().get("defaultPipeline") or GENERIC_DEFAULT_PIPELINE


def canonical_stages():
    return load_config().get("canonicalStages") or GENERIC_CANONICAL_STAGES


def canonical_tags():
    return load_config().get("canonicalTags") or GENERIC_CANONICAL_TAGS


def example_config():
    return load_config().get("examples") or {}


def env_present(name):
    return bool(os.environ.get(name) or dotenv_values().get(name))


def request(
    method,
    path,
    *,
    query=None,
    body=None,
    yes=False,
    mutates=None,
    version=None,
    sanitize_errors=False,
):
    method = method.upper()
    if mutates is None:
        mutates = method in WRITE_METHODS
    query = query or {}
    body = body or None
    url = f"{api_base_url()}{path}"
    if query:
        url = f"{url}?{urllib.parse.urlencode(query, doseq=True)}"

    if mutates and not yes:
        return {
            "dryRun": True,
            "method": method,
            "url": url,
            "body": body,
            "message": "Re-run with --yes to execute.",
        }

    data = None
    headers = {
        "Authorization": f"Bearer {token()}",
        "Version": version or VERSION,
        "Accept": "application/json",
        "User-Agent": f"crm-manager-ghl-cli/{CLI_VERSION}",
    }
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with HTTP_OPENER.open(req) as resp:
            try:
                raw = resp.read().decode("utf-8")
            except UnicodeDecodeError:
                if sanitize_errors:
                    fail("GHL response was invalid")
                raise
            if not raw:
                return {}
            try:
                return parse_untrusted_json(raw)
            except UntrustedJsonError:
                if sanitize_errors:
                    fail("GHL response was invalid")
                raise
    except urllib.error.HTTPError as exc:
        if sanitize_errors:
            fail(f"GHL request failed (HTTP {exc.code})")
        raw = exc.read().decode("utf-8", errors="replace")
        fail(f"HTTP {exc.code}: {raw}")
    except urllib.error.URLError as exc:
        if sanitize_errors:
            fail("GHL request failed")
        fail(str(exc))


def parse_kv(values):
    result = {}
    for item in values or []:
        if "=" not in item:
            fail(f"expected NAME=VALUE, got {item!r}")
        key, value = item.split("=", 1)
        key = key.strip()
        value = value.strip()
        if not key:
            fail(f"empty field name in {item!r}")
        result[key] = value
    return result


def pipelines():
    data = request("GET", "/opportunities/pipelines", query={"locationId": location_id()})
    return data.get("pipelines", [])


def find_pipeline(name):
    for pipeline in pipelines():
        if pipeline.get("name") == name:
            return pipeline
    fail(f"pipeline not found: {name}")


def find_stage(pipeline, name):
    for stage in pipeline.get("stages", []):
        if stage.get("name") == name:
            return stage
    fail(f"stage not found in {pipeline.get('name')}: {name}")


def custom_fields(model):
    data = request("GET", f"/locations/{location_id()}/customFields", query={"model": model})
    return data.get("customFields", [])


def field_map(model):
    return {field.get("name"): field for field in custom_fields(model)}


def custom_field_payload(model, field_values):
    fields = field_map(model)
    payload = []
    for name, value in field_values.items():
        field = fields.get(name)
        if not field:
            fail(f"{model} custom field not found: {name}")
        if field.get("dataType") == "MULTIPLE_OPTIONS" and isinstance(value, str):
            value = [part.strip() for part in value.split(",") if part.strip()]
        payload.append({"id": field["id"], "field_value": value})
    return payload


def summarize_pipelines(args):
    rows = []
    for pipeline in pipelines():
        rows.append({
            "id": pipeline.get("id"),
            "name": pipeline.get("name"),
            "stages": [stage.get("name") for stage in pipeline.get("stages", [])],
        })
    print_json(rows)


def summarize_fields(args):
    rows = []
    for field in custom_fields(args.model):
        rows.append({
            "id": field.get("id"),
            "name": field.get("name"),
            "model": field.get("model"),
            "dataType": field.get("dataType"),
            "fieldKey": field.get("fieldKey"),
            "options": field.get("picklistOptions") or field.get("options"),
        })
    print_json(rows)


def list_tags(args):
    data = request("GET", f"/locations/{location_id()}/tags")
    print_json(data.get("tags", data))


def create_tag(args):
    print_json(request("POST", f"/locations/{location_id()}/tags/", body={"name": args.name}, yes=args.yes) or {})


def delete_tag(args):
    require_delete_confirmation(args)
    print_json(request("DELETE", f"/locations/{location_id()}/tags/{args.id}", yes=args.yes) or {})


def search_contacts(args):
    body = {
        "locationId": location_id(),
        "page": args.page,
        "pageLimit": args.limit,
    }
    if args.query:
        body["query"] = args.query
    data = request("POST", "/contacts/search", body=body, mutates=False)
    print_json(data)


def get_contact(args):
    print_json(request("GET", f"/contacts/{args.id}"))


PHONE_LABELS = {
    "home": "Home",
    "work": "Work",
    "mobile": "Mobile",
    "landline": "Landline",
    "unlabeled": None,
}

DND_CHANNELS = ("Call", "Email", "SMS", "WhatsApp", "GMB", "FB")
DND_STATUSES = ("active", "inactive", "permanent")


def parse_phone_entries(values):
    entries = []
    seen = set()
    for item in values or []:
        if "=" not in item:
            fail(f"expected LABEL=PHONE, got {item!r}")
        raw_label, phone = item.split("=", 1)
        label_key = raw_label.strip().lower()
        phone = phone.strip()
        if label_key not in PHONE_LABELS:
            fail(
                "invalid phone label; expected Home, Work, Mobile, Landline, or Unlabeled"
            )
        if not phone:
            fail(f"empty phone value in {item!r}")
        normalized = re.sub(r"\D", "", phone)
        if not normalized:
            fail(f"invalid phone value in {item!r}")
        if len(normalized) == 10:
            normalized = f"1{normalized}"
        if normalized in seen:
            fail(f"duplicate phone value: {phone}")
        seen.add(normalized)
        entry = {"phone": phone}
        label = PHONE_LABELS[label_key]
        if label:
            entry["label"] = label
        entries.append(entry)
    return entries


def contact_write_body(args, *, require_name=False):
    body = {}
    if require_name and not args.name:
        fail("--name is required")
    if args.name:
        body["name"] = args.name
    if args.email:
        body["email"] = args.email
    if args.company:
        body["companyName"] = args.company
    if args.tag:
        body["tags"] = args.tag

    phone_entries = parse_phone_entries(args.phone_entry)
    if phone_entries and (args.phone or args.phone_label):
        fail("--phone-entry cannot be combined with --phone or --phone-label")
    if phone_entries:
        body["additionalPhones"] = phone_entries
    elif args.phone:
        body["phone"] = args.phone
        if args.phone_label:
            body["phoneLabel"] = args.phone_label
    elif args.phone_label:
        fail("--phone-label requires --phone")

    if args.additional_email:
        body["additionalEmails"] = [{"email": email} for email in args.additional_email]

    fields = parse_kv(args.field)
    if fields:
        body["customFields"] = custom_field_payload("contact", fields)
    return body


def add_contact_write_arguments(parser, *, require_name=False):
    parser.add_argument("--name", required=require_name)
    parser.add_argument("--email")
    parser.add_argument("--phone")
    parser.add_argument("--phone-label", choices=["Home", "Work", "Mobile", "Landline"])
    parser.add_argument(
        "--phone-entry",
        action="append",
        help="complete ordered phone set as LABEL=PHONE; repeat as needed",
    )
    parser.add_argument("--additional-email", action="append")
    parser.add_argument("--company")
    parser.add_argument("--tag", action="append")
    parser.add_argument("--field", action="append", help="custom field as NAME=VALUE")


def create_contact(args):
    contact_body = contact_write_body(args, require_name=True)
    body = {"locationId": location_id(), **contact_body}
    print_json(request("POST", "/contacts/", body=body, yes=args.yes) or {})


def upsert_contact(args):
    body = {
        "locationId": location_id(),
        "name": args.name,
        "email": args.email,
        "phone": args.phone,
        "companyName": args.company,
        "tags": args.tag or None,
    }
    fields = parse_kv(args.field)
    if fields:
        body["customFields"] = custom_field_payload("contact", fields)
    body = {key: value for key, value in body.items() if value not in (None, "", [])}
    print_json(request("POST", "/contacts/upsert", body=body, yes=args.yes) or {})


def update_contact(args):
    body = contact_write_body(args)
    if not body:
        fail("nothing to update")
    print_json(request("PUT", f"/contacts/{args.id}", body=body, yes=args.yes) or {})


def merge_dnd_settings(contact, channel, status):
    current = contact.get("dndSettings") or {}
    if not isinstance(current, dict):
        fail("contact dndSettings is not an object")
    merged = {key: value.copy() if isinstance(value, dict) else value for key, value in current.items()}
    channel_settings = merged.get(channel) or {}
    if not isinstance(channel_settings, dict):
        fail(f"contact dndSettings.{channel} is not an object")
    merged[channel] = {**channel_settings, "status": status}
    return merged


def update_contact_dnd(args):
    data = request("GET", f"/contacts/{args.id}")
    contact = data.get("contact", data)
    if not isinstance(contact, dict):
        fail("contact response is not an object")
    body = {"dndSettings": merge_dnd_settings(contact, args.channel, args.status)}
    print_json(request("PUT", f"/contacts/{args.id}", body=body, yes=args.yes) or {})


def delete_contact(args):
    require_delete_confirmation(args)
    print_json(request("DELETE", f"/contacts/{args.id}", yes=args.yes) or {})


class OpportunityPaginationError(RuntimeError):
    pass


def validate_opportunity_search_meta(meta, page_number, expected_total):
    if not isinstance(meta, dict):
        raise OpportunityPaginationError(
            f"opportunity search page {page_number} returned malformed pagination metadata"
        )

    total = meta.get("total")
    if total is not None:
        valid_total = (
            isinstance(total, (int, float))
            and not isinstance(total, bool)
            and math.isfinite(total)
            and total >= 0
            and total == int(total)
        )
        if not valid_total:
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} returned a malformed pagination total"
            )
        total = int(total)
        if expected_total is not None and total != expected_total:
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} changed pagination total "
                f"from {expected_total} to {total}"
            )
        expected_total = total

    next_page = meta.get("nextPage")
    if next_page is not None:
        valid_next_page = (
            isinstance(next_page, (int, float))
            and not isinstance(next_page, bool)
            and math.isfinite(next_page)
            and next_page > 0
            and next_page == int(next_page)
        )
        if not valid_next_page:
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} returned a malformed nextPage value"
            )

    next_page_url = meta.get("nextPageUrl")
    if next_page_url is not None and (
        not isinstance(next_page_url, str) or not next_page_url.strip()
    ):
        raise OpportunityPaginationError(
            f"opportunity search page {page_number} returned a malformed nextPageUrl value"
        )
    return expected_total, next_page is not None or next_page_url is not None


def validate_opportunity_search_cursor(meta, page_number):
    if "startAfter" not in meta or "startAfterId" not in meta:
        raise OpportunityPaginationError(
            f"opportunity search page {page_number} is missing pagination cursor fields"
        )

    start_after = meta["startAfter"]
    start_after_id = meta["startAfterId"]
    valid_timestamp = (
        isinstance(start_after, (int, float))
        and not isinstance(start_after, bool)
        and math.isfinite(start_after)
    ) or (
        isinstance(start_after, str)
        and re.fullmatch(r"[0-9]+", start_after) is not None
    )
    if not valid_timestamp or not isinstance(start_after_id, str) or not start_after_id:
        raise OpportunityPaginationError(
            f"opportunity search page {page_number} returned a malformed pagination cursor"
        )
    return {"startAfter": start_after, "startAfterId": start_after_id}


def paginate_opportunity_search(fetch_page):
    result = None
    collected = []
    seen_opportunity_ids = set()
    cursor = None
    seen_cursors = set()
    page_number = 0
    expected_total = None
    terminal_meta = None

    while True:
        page_number += 1
        page = fetch_page(cursor)
        if not isinstance(page, dict):
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} returned a malformed response"
            )
        opportunities = page.get("opportunities")
        if not isinstance(opportunities, list):
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} returned a malformed opportunities list"
            )
        if result is None:
            result = dict(page)

        meta = page.get("meta")
        expected_total, meta_continues = validate_opportunity_search_meta(
            meta, page_number, expected_total
        )

        page_opportunity_ids = set()
        for index, opportunity in enumerate(opportunities):
            if not isinstance(opportunity, dict):
                raise OpportunityPaginationError(
                    f"opportunity search page {page_number} returned a malformed "
                    f"opportunity at index {index}"
                )
            opportunity_id = opportunity.get("id")
            if not isinstance(opportunity_id, str) or not opportunity_id.strip():
                raise OpportunityPaginationError(
                    f"opportunity search page {page_number} returned a malformed "
                    f"opportunity id at index {index}"
                )
            if (
                opportunity_id in seen_opportunity_ids
                or opportunity_id in page_opportunity_ids
            ):
                raise OpportunityPaginationError(
                    f"opportunity search page {page_number} repeated opportunity id "
                    f"{opportunity_id!r}"
                )
            page_opportunity_ids.add(opportunity_id)

        seen_opportunity_ids.update(page_opportunity_ids)
        collected.extend(opportunities)
        if expected_total is not None and len(collected) > expected_total:
            raise OpportunityPaginationError(
                f"opportunity search collected {len(collected)} records, "
                f"which exceeds pagination total {expected_total}"
            )

        should_continue = (
            meta_continues
            or len(opportunities) >= OPPORTUNITY_SEARCH_PAGE_SIZE
        )
        if should_continue and not opportunities:
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} made no record progress"
            )
        if not should_continue:
            if expected_total is not None and len(collected) != expected_total:
                raise OpportunityPaginationError(
                    f"opportunity search collected {len(collected)} records, "
                    f"which does not match pagination total {expected_total}"
                )
            terminal_meta = dict(meta)
            break

        cursor = validate_opportunity_search_cursor(meta, page_number)
        cursor_start_after = cursor["startAfter"]
        if isinstance(cursor_start_after, str):
            cursor_start_after_key = cursor_start_after.lstrip("0") or "0"
        elif isinstance(cursor_start_after, float) and cursor_start_after.is_integer():
            cursor_start_after_key = str(int(cursor_start_after))
        else:
            cursor_start_after_key = str(cursor_start_after)
        cursor_key = (cursor_start_after_key, cursor["startAfterId"])
        if cursor_key in seen_cursors:
            raise OpportunityPaginationError(
                f"opportunity search page {page_number} repeated its pagination cursor"
            )
        seen_cursors.add(cursor_key)

    result = result or {"opportunities": []}
    result["opportunities"] = collected
    result["meta"] = terminal_meta
    return result


def search_opportunities(args):
    base_query = {
        "location_id": location_id(),
        "status": args.status,
    }
    if args.query:
        base_query["q"] = args.query
    if args.pipeline:
        base_query["pipeline_id"] = find_pipeline(args.pipeline)["id"]

    if not args.all:
        data = request(
            "GET",
            "/opportunities/search",
            query={**base_query, "limit": args.limit},
        )
        print_json(data)
        return

    def fetch_page(cursor):
        query = {**base_query, "limit": OPPORTUNITY_SEARCH_PAGE_SIZE}
        if cursor is not None:
            query.update(cursor)
        return request("GET", "/opportunities/search", query=query)

    try:
        data = paginate_opportunity_search(fetch_page)
    except OpportunityPaginationError as exc:
        fail(str(exc))
    print_json(data)


def create_opportunity(args):
    pipeline = find_pipeline(args.pipeline)
    stage = find_stage(pipeline, args.stage)
    body = {
        "locationId": location_id(),
        "contactId": args.contact_id,
        "pipelineId": pipeline["id"],
        "pipelineStageId": stage["id"],
        "name": args.name,
        "status": args.status,
    }
    if args.value is not None:
        body["monetaryValue"] = args.value
    fields = parse_kv(args.field)
    if fields:
        body["customFields"] = custom_field_payload("opportunity", fields)
    print_json(request("POST", "/opportunities/", body=body, yes=args.yes) or {})


def update_opportunity(args):
    body = {}
    if args.name:
        body["name"] = args.name
    if args.status:
        body["status"] = args.status
    if args.value is not None:
        body["monetaryValue"] = args.value
    if args.pipeline or args.stage:
        pipeline = find_pipeline(args.pipeline or default_pipeline_name())
        body["pipelineId"] = pipeline["id"]
        if args.stage:
            body["pipelineStageId"] = find_stage(pipeline, args.stage)["id"]
    fields = parse_kv(args.field)
    if fields:
        body["customFields"] = custom_field_payload("opportunity", fields)
    if not body:
        fail("nothing to update")
    print_json(request("PUT", f"/opportunities/{args.id}", body=body, yes=args.yes) or {})


def next_step_opportunity(args):
    if not args.step and not args.date:
        fail("nothing to update; provide --step and/or --date")
    if args.date and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.date):
        fail(f"expected --date as YYYY-MM-DD, got {args.date!r}")
    fields = {}
    if args.step:
        fields["Next Step"] = args.step
    if args.date:
        fields["Next Step Date"] = args.date
    body = {"customFields": custom_field_payload("opportunity", fields)}
    print_json(request("PUT", f"/opportunities/{args.id}", body=body, yes=args.yes) or {})


def delete_opportunity(args):
    require_delete_confirmation(args)
    print_json(request("DELETE", f"/opportunities/{args.id}", yes=args.yes) or {})


def filter_task_search_result(data, exclude_unlinked=False):
    tasks = data.get("tasks")
    if isinstance(tasks, list):
        unlinked = [task for task in tasks if not task.get("contactId")]
        if unlinked:
            data["unlinkedTaskCount"] = len(unlinked)
        if exclude_unlinked:
            data["tasks"] = [task for task in tasks if task.get("contactId")]
    return data


class TaskPaginationError(RuntimeError):
    pass


def validate_task_search_cursor(cursor, page_number):
    def valid_number(value):
        return (
            isinstance(value, (int, float))
            and not isinstance(value, bool)
            and math.isfinite(value)
        )

    if (
        not isinstance(cursor, list)
        or len(cursor) != 2
        or not valid_number(cursor[0])
        or not isinstance(cursor[1], str)
        or not cursor[1]
    ):
        raise TaskPaginationError(
            f"task search page {page_number} returned a malformed searchAfter cursor"
        )
    return cursor


def paginate_task_search(limit, fetch_page):
    if limit <= 0:
        raise TaskPaginationError("task search --limit must be greater than zero")

    result = None
    collected = []
    cursor = None
    seen_cursors = set()
    page_number = 0

    while len(collected) < limit:
        page_number += 1
        body = {"limit": min(TASK_SEARCH_PAGE_SIZE, limit - len(collected))}
        if cursor is not None:
            body["searchAfter"] = cursor

        page = fetch_page(body)
        if not isinstance(page, dict):
            raise TaskPaginationError(
                f"task search page {page_number} returned a malformed response"
            )
        tasks = page.get("tasks")
        if not isinstance(tasks, list):
            raise TaskPaginationError(
                f"task search page {page_number} returned a malformed tasks list"
            )
        if result is None:
            result = dict(page)

        remaining = limit - len(collected)
        collected.extend(tasks[:remaining])
        if len(collected) >= limit or len(tasks) < TASK_SEARCH_PAGE_SIZE:
            break

        last_task = tasks[-1]
        if not isinstance(last_task, dict) or "searchAfter" not in last_task:
            raise TaskPaginationError(
                f"task search page {page_number} is missing a searchAfter cursor"
            )
        cursor = validate_task_search_cursor(last_task["searchAfter"], page_number)
        cursor_key = json.dumps(cursor, separators=(",", ":"))
        if cursor_key in seen_cursors:
            raise TaskPaginationError(
                f"task search page {page_number} repeated its searchAfter cursor"
            )
        seen_cursors.add(cursor_key)

    result = result or {"tasks": []}
    result["tasks"] = collected
    return result


def search_tasks(args):
    path = f"/locations/{location_id()}/tasks/search"

    def fetch_page(body):
        return request(
            "POST",
            path,
            body=body,
            mutates=False,
            version=TASKS_VERSION,
        )

    try:
        data = paginate_task_search(args.limit, fetch_page)
    except TaskPaginationError as exc:
        fail(str(exc))
    data = filter_task_search_result(data, exclude_unlinked=args.exclude_unlinked)
    print_json(data)


def validate_iso_datetime(value, flag="--due"):
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        fail(f"expected {flag} as an ISO 8601 datetime with timezone, got {value!r}")
    if parsed.tzinfo is None:
        fail(f"expected {flag} as an ISO 8601 datetime with timezone, got {value!r}")
    return value


def create_task(args):
    body = {
        "title": args.title,
        "body": args.body or "",
        "dueDate": validate_iso_datetime(args.due),
        "assignedTo": args.assigned_to,
        "completed": False,
    }
    print_json(
        request(
            "POST",
            f"/contacts/{args.contact_id}/tasks",
            body=body,
            yes=args.yes,
            version=TASKS_VERSION,
        )
        or {}
    )


def update_task(args):
    body = {}
    if args.title:
        body["title"] = args.title
    if args.body is not None:
        body["body"] = args.body
    if args.due:
        body["dueDate"] = validate_iso_datetime(args.due)
    if args.assigned_to:
        body["assignedTo"] = args.assigned_to
    if not body:
        fail("nothing to update")
    print_json(
        request(
            "PUT",
            f"/contacts/{args.contact_id}/tasks/{args.id}",
            body=body,
            yes=args.yes,
            version=TASKS_VERSION,
        )
        or {}
    )


def complete_task(args):
    print_json(
        request(
            "PUT",
            f"/contacts/{args.contact_id}/tasks/{args.id}/completed",
            body={"completed": True},
            yes=args.yes,
            version=TASKS_VERSION,
        )
        or {}
    )


def delete_task(args):
    require_delete_confirmation(args)
    print_json(
        request(
            "DELETE",
            f"/contacts/{args.contact_id}/tasks/{args.id}",
            yes=args.yes,
            version=TASKS_VERSION,
        )
        or {}
    )


